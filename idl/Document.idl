// NOTE Using DOMString instead of USVString
// REF1. https://www.w3.org/TR/dom/#interface-document
// REF2. https://dom.spec.whatwg.org/#interface-document
// REF3. https://html.spec.whatwg.org/multipage/dom.html#the-document-object
// REF4. https://www.w3.org/TR/page-visibility/#sec-document-interface
// REF5. https://drafts.csswg.org/cssom-view/#extensions-to-the-document-interface
// REF6. https://drafts.csswg.org/cssom/#extensions-to-the-document-interface
// REF7. https://www.w3.org/TR/dom/#interface-nonelementparentnode
// REF8. https://www.w3.org/TR/dom/#parentnode


// [REF3]----------------------------------------------------------------
enum DocumentReadyState { "loading", "interactive", "complete" };
typedef (HTMLScriptElement or SVGScriptElement) HTMLOrSVGScriptElement;


// [REF4]----------------------------------------------------------------
enum VisibilityState { "hidden", "visible", "prerender", "unloaded" };


[Constructor,
 Exposed=Window]
interface Document : Node {
  // [REF1]--------------------------------------------------------------
  [STARFISH_EXP, SameObject] readonly attribute DOMImplementation implementation;
  [Rename=urlString] readonly attribute DOMString URL;
  [Rename=urlString] readonly attribute DOMString documentURI;
  [Unimplemented] readonly attribute DOMString origin;
  readonly attribute DOMString compatMode;
  readonly attribute DOMString characterSet;
  [Rename=characterSet] readonly attribute DOMString charset;
  [Unimplemented] readonly attribute DOMString inputEncoding;
  readonly attribute DOMString contentType;

  readonly attribute DocumentType? doctype;
  readonly attribute Element? documentElement;
  HTMLCollection getElementsByTagName(DOMString qualifiedName);
  [Unimplemented] HTMLCollection getElementsByTagNameNS(DOMString? namespace, DOMString localName);
  HTMLCollection getElementsByClassName(DOMString classNames);

  [NewObject] Element createElement(DOMString localName, optional ElementCreationOptions options);
  [Unimplemented, NewObject] Element createElementNS(DOMString? namespace, DOMString qualifiedName, optional ElementCreationOptions options);
  [NewObject] DocumentFragment createDocumentFragment();
  [NewObject] Text createTextNode(DOMString data);
  [Unimplemented, NewObject] CDATASection createCDATASection(DOMString data);
  [NewObject] Comment createComment(DOMString data);
  [Unimplemented, NewObject] ProcessingInstruction createProcessingInstruction(DOMString target, DOMString data);

  [Unimplemented, CEReactions, NewObject] Node importNode(Node node, optional boolean deep = false);
  [Unimplemented, CEReactions] Node adoptNode(Node node);

  [NewObject] Attr createAttribute(DOMString localName);
  [Unimplemented, NewObject] Attr createAttributeNS(DOMString? namespace, DOMString qualifiedName);

  [Unimplemented, NewObject] Event createEvent(DOMString type);

  [Unimplemented, NewObject] Range createRange();

  // NodeFilter.SHOW_ALL = 0xFFFFFFFF
  [Unimplemented, NewObject] NodeIterator createNodeIterator(Node root, optional unsigned long whatToShow = 0xFFFFFFFF, optional NodeFilter? filter = null);
  [Unimplemented, NewObject] TreeWalker createTreeWalker(Node root, optional unsigned long whatToShow = 0xFFFFFFFF, optional NodeFilter? filter = null);



  // [REF3]--------------------------------------------------------------
  // resource metadata management
  [CustomSetter, PutForwards=href, Unforgeable] readonly attribute Location? location;
  [Unimplemented] attribute DOMString domain;
  [Unimplemented] readonly attribute DOMString referrer;
  [Unimplemented] attribute DOMString cookie;
  [Unimplemented] readonly attribute DOMString lastModified;
  [Unimplemented] readonly attribute DocumentReadyState readyState;

  // DOM tree accessors
  // getter object (DOMString name);
  [Unimplemented, CEReactions] attribute DOMString title;
  [Unimplemented, CEReactions] attribute DOMString dir;
  [CustomSetter, CEReactions] attribute HTMLElement? body;
  readonly attribute HTMLHeadElement? head;
  [Unimplemented, SameObject] readonly attribute HTMLCollection images;
  [Unimplemented, SameObject] readonly attribute HTMLCollection embeds;
  [Unimplemented, SameObject] readonly attribute HTMLCollection plugins;
  [Unimplemented, SameObject] readonly attribute HTMLCollection links;
  [Unimplemented, SameObject] readonly attribute HTMLCollection forms;
  [Unimplemented, SameObject] readonly attribute HTMLCollection scripts;
  [Unimplemented] NodeList getElementsByName(DOMString elementName);
  [Unimplemented] readonly attribute HTMLOrSVGScriptElement? currentScript; // classic scripts in a document tree only

  // dynamic markup insertion
  [Unimplemented, CEReactions] Document open(optional DOMString type = "text/html", optional DOMString replace = "");
  [Unimplemented] WindowProxy open(DOMString url, DOMString name, DOMString features);
  [Unimplemented, CEReactions] void close();
  [Unimplemented, CEReactions] void write(DOMString... text);
  [Unimplemented, CEReactions] void writeln(DOMString... text);

  // user interaction
  [CustomGetter] readonly attribute WindowProxy? defaultView;
  [Unimplemented] readonly attribute Element? activeElement;
  [Unimplemented] boolean hasFocus();
  [Unimplemented, CEReactions] attribute DOMString designMode;
  [Unimplemented, CEReactions] boolean execCommand(DOMString commandId, optional boolean showUI = false, optional DOMString value = "");
  [Unimplemented] boolean queryCommandEnabled(DOMString commandId);
  [Unimplemented] boolean queryCommandIndeterm(DOMString commandId);
  [Unimplemented] boolean queryCommandState(DOMString commandId);
  [Unimplemented] boolean queryCommandSupported(DOMString commandId);
  [Unimplemented] DOMString queryCommandValue(DOMString commandId);

  // special event handler IDL attributes that only apply to Document objects
  [LenientThis] attribute EventHandler onreadystatechange;



  // [REF4]--------------------------------------------------------------
  readonly attribute boolean hidden;
  readonly attribute VisibilityState visibilityState;



  // [REF5]--------------------------------------------------------------
  Element? elementFromPoint(double x, double y);
  [Unimplemented] sequence<Element> elementsFromPoint(double x, double y);
  [Unimplemented] CaretPosition? caretPositionFromPoint(double x, double y);
  [Unimplemented] readonly attribute Element? scrollingElement;



  // [REF6]--------------------------------------------------------------
  [Unimplemented, SameObject] readonly attribute StyleSheetList styleSheets;



  // TODO Support implements
  // Document implements GlobalEventHandlers;
  // [REF3] -------------------------------------------------------------
  [Unimplemented] attribute EventHandler onabort;
  [Unimplemented] attribute EventHandler onauxclick;
  [Unimplemented] attribute EventHandler onblur;
  [Unimplemented] attribute EventHandler oncancel;
  [Unimplemented] attribute EventHandler oncanplay;
  [Unimplemented] attribute EventHandler oncanplaythrough;
  [Unimplemented] attribute EventHandler onchange;
  attribute EventHandler onclick;
  [Unimplemented] attribute EventHandler onclose;
  [Unimplemented] attribute EventHandler oncontextmenu;
  [Unimplemented] attribute EventHandler oncuechange;
  [Unimplemented] attribute EventHandler ondblclick;
  [Unimplemented] attribute EventHandler ondrag;
  [Unimplemented] attribute EventHandler ondragend;
  [Unimplemented] attribute EventHandler ondragenter;
  [Unimplemented] attribute EventHandler ondragexit;
  [Unimplemented] attribute EventHandler ondragleave;
  [Unimplemented] attribute EventHandler ondragover;
  [Unimplemented] attribute EventHandler ondragstart;
  [Unimplemented] attribute EventHandler ondrop;
  [Unimplemented] attribute EventHandler ondurationchange;
  [Unimplemented] attribute EventHandler onemptied;
  [Unimplemented] attribute EventHandler onended;
  [Unimplemented] attribute OnErrorEventHandler onerror;
  attribute EventHandler onfocus;
  [Unimplemented] attribute EventHandler oninput;
  [Unimplemented] attribute EventHandler oninvalid;
  attribute EventHandler onkeydown;
  [Unimplemented] attribute EventHandler onkeypress;
  [Unimplemented] attribute EventHandler onkeyup;
  [Unimplemented] attribute EventHandler onload;
  [Unimplemented] attribute EventHandler onloadeddata;
  [Unimplemented] attribute EventHandler onloadedmetadata;
  [Unimplemented] attribute EventHandler onloadend;
  [Unimplemented] attribute EventHandler onloadstart;
  [Unimplemented] attribute EventHandler onmousedown;
  [Unimplemented, LenientThis] attribute EventHandler onmouseenter;
  [Unimplemented, LenientThis] attribute EventHandler onmouseleave;
  [Unimplemented] attribute EventHandler onmousemove;
  [Unimplemented] attribute EventHandler onmouseout;
  attribute EventHandler onmouseover;
  [Unimplemented] attribute EventHandler onmouseup;
  [Unimplemented] attribute EventHandler onwheel;
  [Unimplemented] attribute EventHandler onpause;
  [Unimplemented] attribute EventHandler onplay;
  [Unimplemented] attribute EventHandler onplaying;
  [Unimplemented] attribute EventHandler onprogress;
  [Unimplemented] attribute EventHandler onratechange;
  [Unimplemented] attribute EventHandler onreset;
  [Unimplemented] attribute EventHandler onresize;
  [Unimplemented] attribute EventHandler onscroll;
  [Unimplemented] attribute EventHandler onseeked;
  [Unimplemented] attribute EventHandler onseeking;
  [Unimplemented] attribute EventHandler onselect;
  [Unimplemented] attribute EventHandler onshow;
  [Unimplemented] attribute EventHandler onstalled;
  [Unimplemented] attribute EventHandler onsubmit;
  [Unimplemented] attribute EventHandler onsuspend;
  [Unimplemented] attribute EventHandler ontimeupdate;
  [Unimplemented] attribute EventHandler ontoggle;
  [Unimplemented] attribute EventHandler onvolumechange;
  [Unimplemented] attribute EventHandler onwaiting;



  // TODO Support implements
  // Document implements DocumentAndElementEventHandlers;
  // [REF3] -------------------------------------------------------------
  [Unimplemented] attribute EventHandler onafterprint;
  [Unimplemented] attribute EventHandler onbeforeprint;
  [Unimplemented] attribute OnBeforeUnloadEventHandler onbeforeunload;
  [Unimplemented] attribute EventHandler onhashchange;
  [Unimplemented] attribute EventHandler onlanguagechange;
  [Unimplemented] attribute EventHandler onmessage;
  [Unimplemented] attribute EventHandler onoffline;
  [Unimplemented] attribute EventHandler ononline;
  [Unimplemented] attribute EventHandler onpagehide;
  [Unimplemented] attribute EventHandler onpageshow;
  [Unimplemented] attribute EventHandler onpopstate;
  [Unimplemented] attribute EventHandler onrejectionhandled;
  [Unimplemented] attribute EventHandler onstorage;
  [Unimplemented] attribute EventHandler onunhandledrejection;
  [Unimplemented] attribute EventHandler onunload;



  // TODO Support implements
  // Document implements NonElementParentNode;
  // [REF7] -------------------------------------------------------------
  // https://www.w3.org/TR/dom/#interface-nonelementparentnode
  Element? getElementById(DOMString elementId);



  // TODO Support implements
  // Document implements ParentNode;
  // [REF8] -------------------------------------------------------------
  [SameObject] readonly attribute HTMLCollection children;
  readonly attribute Element? firstElementChild;
  readonly attribute Element? lastElementChild;
  readonly attribute unsigned long childElementCount;

  Element? querySelector(DOMString selectors);
  [STARFISH_ENABLE_WASU, NewObject] NodeList querySelectorAll(DOMString selectors);
};

Document implements GlobalEventHandlers;
Document implements DocumentAndElementEventHandlers;
Document implements NonElementParentNode
Document implements ParentNode

// [REF1]
[Exposed=Window]
interface XMLDocument : Document {};

// [REF1]
dictionary ElementCreationOptions {
  DOMString is;
};